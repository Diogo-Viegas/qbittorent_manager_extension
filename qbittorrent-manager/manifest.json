{
  "manifest_version": 3,
  "name": "Meu qBittorrent Manager (Pi NAS)",
  "version": "1.1",
  "description": "Janela de confirmação ao clicar em links magnet e gestor de downloads no Raspberry Pi.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://192.168.1.38:8082/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "qBittorrent Manager"
  }
}